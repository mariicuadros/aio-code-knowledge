{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aio-code.vercel.app/brain/contracts/brain-record-v1.schema.json",
  "title": "AIO CODE Brain record contract v1.0.0",
  "description": "Seven frozen-Brain record shapes. Operational data stays private. Schema validation is not verification of evidence or permission.",
  "$defs": {
    "content_type": {
      "type": "string",
      "enum": [
        "CANON",
        "TRAILER",
        "LIFE",
        "CUT",
        "EDITORIAL",
        "STORY",
        "DOC",
        "SHORT",
        "TRIAL",
        "SPEC"
      ],
      "description": "Controlled dictionary: vocabulary-v1.json terms."
    },
    "commercial_relationship": {
      "type": "string",
      "enum": [
        "NONE",
        "ORGANIC",
        "SPEC",
        "GIFT",
        "PAID",
        "AFF",
        "OWN",
        "unknown"
      ],
      "description": "Controlled dictionary: vocabulary-v1.json terms."
    },
    "lens": {
      "type": "string",
      "enum": [
        "REAL",
        "VOID",
        "HYBRID"
      ],
      "description": "Controlled dictionary: vocabulary-v1.json terms."
    },
    "narrative_function": {
      "type": "string",
      "enum": [
        "SEED",
        "TEASE",
        "BRIDGE",
        "EXPAND",
        "REVEAL",
        "CALLBACK",
        "PAYOFF",
        "STANDALONE"
      ],
      "description": "Controlled dictionary: vocabulary-v1.json terms."
    },
    "pause_type": {
      "type": "string",
      "enum": [
        "NONE",
        "REACTION",
        "TENSION",
        "REVEAL",
        "INTIMACY",
        "UNCERTAINTY"
      ],
      "description": "Controlled dictionary: vocabulary-v1.json terms."
    },
    "objective": {
      "type": "string",
      "enum": [
        "DISCOVERY",
        "SEARCH",
        "RETENTION",
        "LORE",
        "MUSIC",
        "BRAND",
        "CONVERSION",
        "OTHER"
      ],
      "description": "Controlled dictionary: vocabulary-v1.json terms."
    },
    "readiness": {
      "type": "string",
      "enum": [
        "ORGANIC_ONLY",
        "BRANDREADY",
        "PAIDREADY",
        "REVIEW",
        "RESTRICTED"
      ],
      "description": "Controlled dictionary: vocabulary-v1.json terms."
    },
    "metric_state": {
      "type": "string",
      "enum": [
        "observed",
        "not_collected",
        "not_available",
        "not_applicable"
      ],
      "description": "Controlled dictionary: vocabulary-v1.json terms."
    },
    "rights_state": {
      "type": "string",
      "enum": [
        "unknown",
        "review_required",
        "cleared",
        "restricted",
        "not_applicable"
      ],
      "description": "Controlled dictionary: vocabulary-v1.json terms."
    },
    "disclosure_status": {
      "type": "string",
      "enum": [
        "unknown",
        "required",
        "satisfied",
        "not_required",
        "not_applicable"
      ],
      "description": "Controlled dictionary: vocabulary-v1.json terms."
    },
    "permission_state": {
      "type": "string",
      "enum": [
        "unknown",
        "allowed",
        "denied",
        "not_applicable"
      ],
      "description": "Controlled dictionary: vocabulary-v1.json terms."
    },
    "decision_state": {
      "type": "string",
      "enum": [
        "SCALE",
        "ITERATE",
        "REPACKAGE",
        "RETEST",
        "ARCHIVE"
      ],
      "description": "Controlled dictionary: vocabulary-v1.json terms."
    },
    "metric": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/metric_state"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "value",
        "state",
        "unit",
        "definition",
        "source_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "content_provenance": {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "content_provenance"
        },
        "content_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "visibility": {
          "enum": [
            "private",
            "public"
          ]
        },
        "notes": {
          "type": "string"
        },
        "extensions": {
          "type": "object"
        },
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "parent_content_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "master_asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "platform_derivative_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "content_type": {
          "$ref": "#/$defs/content_type"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "lens": {
          "$ref": "#/$defs/lens"
        },
        "narrative_function": {
          "$ref": "#/$defs/narrative_function"
        },
        "hook": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "first_seen_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "publication_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "intervention_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "changeset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "fingerprint_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "rights_record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "authorship_record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "status": {
          "enum": [
            "draft",
            "approved",
            "published",
            "withdrawn",
            "archived"
          ]
        },
        "commercial_relationship": {
          "$ref": "#/$defs/commercial_relationship"
        },
        "rights_status": {
          "$ref": "#/$defs/rights_state"
        },
        "distribution_mode": {
          "$ref": "#/$defs/distribution_mode"
        },
        "representations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "representation_of": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
              },
              "authorization": {
                "enum": [
                  "SELF_AUTHORIZED",
                  "verified",
                  "pending",
                  "unknown",
                  "not_applicable"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "name",
              "representation_of",
              "authorization",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "record_type",
        "content_id",
        "owner",
        "source_ref",
        "recorded_at",
        "visibility",
        "entity_ids",
        "parent_content_id",
        "master_asset_id",
        "content_type",
        "fingerprint_sha256",
        "status",
        "commercial_relationship",
        "rights_status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "published"
              }
            }
          },
          "then": {
            "required": [
              "published_at",
              "platform",
              "publication_ref",
              "intervention_id"
            ],
            "properties": {
              "published_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|\\+00:00)$"
              }
            }
          }
        }
      ]
    },
    "semantic_search": {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "semantic_search"
        },
        "map_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "visibility": {
          "enum": [
            "private",
            "public"
          ]
        },
        "notes": {
          "type": "string"
        },
        "extensions": {
          "type": "object"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "audience_question": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "canonical_concept": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "answer_first_definition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "disambiguation_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "methodology_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "reviewed",
            "approved"
          ]
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        }
      },
      "required": [
        "record_type",
        "map_id",
        "owner",
        "source_ref",
        "recorded_at",
        "visibility",
        "entity_id",
        "audience_question",
        "language",
        "canonical_concept",
        "answer_first_definition",
        "evidence_refs",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "reviewed",
                  "approved"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reviewed_by",
              "reviewed_at"
            ],
            "properties": {
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        }
      ]
    },
    "performance_observation": {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "performance_observation"
        },
        "observation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "visibility": {
          "enum": [
            "private",
            "public"
          ]
        },
        "notes": {
          "type": "string"
        },
        "extensions": {
          "type": "object"
        },
        "content_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "measurement_label": {
          "enum": [
            "1h",
            "6h",
            "24h",
            "72h",
            "7d",
            "30d",
            "custom"
          ]
        },
        "measurement_window": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            "end": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "capture_source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "$ref": "#/$defs/metric"
          }
        },
        "commercial_signals": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "$ref": "#/$defs/metric"
          }
        },
        "retention_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position_seconds": {
                "type": "number",
                "minimum": 0
              },
              "metric": {
                "$ref": "#/$defs/metric"
              }
            },
            "required": [
              "position_seconds",
              "metric"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "record_type",
        "observation_id",
        "owner",
        "source_ref",
        "recorded_at",
        "visibility",
        "content_id",
        "platform",
        "measurement_label",
        "measurement_window",
        "captured_at",
        "capture_source",
        "metrics"
      ],
      "additionalProperties": false
    },
    "content_genome": {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "content_genome"
        },
        "genome_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "visibility": {
          "enum": [
            "private",
            "public"
          ]
        },
        "notes": {
          "type": "string"
        },
        "extensions": {
          "type": "object"
        },
        "content_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
        },
        "content_type": {
          "$ref": "#/$defs/content_type"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "lens": {
          "$ref": "#/$defs/lens"
        },
        "narrative_function": {
          "$ref": "#/$defs/narrative_function"
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "hook_type": {
          "$ref": "#/$defs/hook_type"
        },
        "open_question": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "theme": {
          "$ref": "#/$defs/theme"
        },
        "emotion": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "narrative_beats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "visual_elements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "audio_elements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "pause_type": {
          "$ref": "#/$defs/pause_type"
        },
        "loop_design": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "not_applicable"
            }
          ]
        },
        "call_to_action": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "search_intent": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "brand_verticals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "intended_audience": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_of_description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "record_type",
        "genome_id",
        "owner",
        "source_ref",
        "recorded_at",
        "visibility",
        "content_id",
        "content_type",
        "subject",
        "lens",
        "narrative_function",
        "format",
        "hook_type",
        "pause_type",
