{
  "manifest": "AIO CODE Controlled Data Export",
  "version": "1.3",
  "updated": "2026-10-09",
  "source_of_truth": "GitHub repository mariicuadros/aio-code-knowledge",
  "downstream_targets": [
    "Hugging Face"
  ],
  "policy": "Only listed sources may be exported. Hugging Face publication requires a separate founder-authorized manual workflow_dispatch for an exact approved main commit; pushes and merges do not publish. Documentation is not mirrored wholesale.",
  "sources": [
    "entity-graph.json",
    "social-entity-map.json",
    "claim-ledger.json",
    "ai-social-baseline.json",
    "observatory/observation-schema.json",
    "observatory/ER-001.json",
    "entity-labs/experiment-schema.json",
    "entity-labs/EXP-001.json",
    "metrics/metric-schema.json",
    "entity/content/MC-001/content-registry.json",
    "entity/content/MC-001/platforms.json",
    "entity/content/MC-001/spotify-playlists.json",
    "entity/content/NUX-001/content-registry.json",
    "entity/content/NUX-001/platforms.json",
    "entity/content/AIO-001/content-registry.json",
    "entity/content/AIO-001/platforms.json",
    "entity/ENTITY-PASSPORT-OZCU.md",
    "entity/ENTITY-PASSPORT-VOID-MODE.md",
    "observatory/interventions/INT-OZCU-001-20260925-001.json",
    "data-export/journal-addendum.jsonl",
    "observatory/history/aio-code-historical-evidence-index.json",
    "observatory/history/historical-visual-review-20261006.json"
  ],
  "integrity_rules": [
    "Preserve canonical entity IDs.",
    "Do not invent URLs or platform presence.",
    "Do not overwrite historical observations with later measurements.",
    "Do not treat planned records as observed facts.",
    "Do not treat platform presence as proof of AI recognition.",
    "Do not treat defined canonical claims as externally verified findings."
  ]
}
