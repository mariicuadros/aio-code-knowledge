{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "action": {
      "enum": [
        "request",
        "review",
        "reserve",
        "bind",
        "withdraw"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^REQ-[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^ENT-[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "case_revision": {
      "type": "integer",
      "minimum": 1
    },
    "case_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "payload": {},
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    }
  },
  "required": [
    "schema_version",
    "action",
    "request_id",
    "expected_version",
    "case_id",
    "case_revision",
    "case_hash",
    "reason",
    "payload",
    "key"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aio-code:private:canonical-registry-command:v1",
  "title": "Private canonical registry command v1; never public record data",
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "request"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 140
              },
              "type": {
                "enum": [
                  "person",
                  "organization",
                  "project",
                  "creative"
                ]
              },
              "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12,
                "pattern": "^[A-Z][A-Z0-9]{1,11}$"
              },
              "evidence_refs_private": {
                "type": "array",
                "minItems": 1,
                "maxItems": 30,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            },
            "required": [
              "name",
              "type",
              "namespace",
              "evidence_refs_private"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "review"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "decision": {
                "enum": [
                  "approved",
                  "rejected"
                ]
              },
              "identity_checked": {
                "type": "boolean"
              },
              "sources_checked": {
                "type": "boolean"
              },
              "homonyms_resolved": {
                "type": "boolean"
              },
              "rights_authorized": {
                "type": "boolean"
              },
              "evidence_refs_private": {
                "type": "array",
                "minItems": 1,
                "maxItems": 30,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            },
            "required": [
              "decision",
              "identity_checked",
              "sources_checked",
              "homonyms_resolved",
              "rights_authorized",
              "evidence_refs_private"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "decision": {
                      "const": "approved"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "identity_checked": {
                      "const": true
                    },
                    "sources_checked": {
                      "const": true
                    },
                    "homonyms_resolved": {
                      "const": true
                    },
                    "rights_authorized": {
                      "const": true
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "reserve"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "canonical_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16,
                "pattern": "^[A-Z][A-Z0-9]{1,11}-[0-9]{3}$"
              }
            },
            "required": [
              "canonical_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "bind"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "withdraw"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
