{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aio-code.vercel.app/schemas/creator-work-v0.1.schema.json",
  "title": "AIO CODE creator-work-v0.1 v0.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordId",
    "responsibleEntityId",
    "createdAt",
    "revision",
    "visibility",
    "reviewStatus",
    "evidenceRefs",
    "kind",
    "creatorEntityIds",
    "title",
    "workType"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "recordId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*[0-9]$"
    },
    "responsibleEntityId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*[0-9]$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "visibility": {
      "enum": [
        "private",
        "approved_public"
      ]
    },
    "reviewStatus": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "withdrawn"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kind": {
      "const": "CreativeWork"
    },
    "creatorEntityIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9-]*[0-9]$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "workType": {
      "enum": [
        "music",
        "video",
        "image",
        "text",
        "character",
        "other"
      ]
    },
    "versionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contributionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rightsStatementIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "publicationUrls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      }
    }
  },
  "additionalProperties": false
}
