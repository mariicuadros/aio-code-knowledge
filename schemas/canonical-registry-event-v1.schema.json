{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^REQ-[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "action": {
      "enum": [
        "request",
        "review",
        "reserve",
        "bind",
        "withdraw"
      ]
    },
    "status": {
      "enum": [
        "requested",
        "approved",
        "rejected",
        "reserved",
        "bound",
        "withdrawn"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^ENT-[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "case_revision": {
      "type": "integer",
      "minimum": 1
    },
    "case_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "type": {
          "enum": [
            "person",
            "organization",
            "project",
            "creative"
          ]
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "pattern": "^[A-Z][A-Z0-9]{1,11}$"
        },
        "evidence_refs_private": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "required": [
        "name",
        "type",
        "namespace",
        "evidence_refs_private"
      ],
      "additionalProperties": false
    },
    "canonical_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[A-Z][A-Z0-9]{1,11}-[0-9]{3}$"
        }
      ]
    },
    "review": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "enum": [
                "approved",
                "rejected"
              ]
            },
            "identity_checked": {
              "type": "boolean"
            },
            "sources_checked": {
              "type": "boolean"
            },
            "homonyms_resolved": {
              "type": "boolean"
            },
            "rights_authorized": {
              "type": "boolean"
            },
            "evidence_refs_private": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "reviewer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "reviewed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "decision",
            "identity_checked",
            "sources_checked",
            "homonyms_resolved",
            "rights_authorized",
            "evidence_refs_private",
            "reviewer",
            "reviewed_at"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "decision": {
                    "const": "approved"
                  }
                }
              },
              "then": {
                "properties": {
                  "identity_checked": {
                    "const": true
                  },
                  "sources_checked": {
                    "const": true
                  },
                  "homonyms_resolved": {
                    "const": true
                  },
                  "rights_authorized": {
                    "const": true
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "requester": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "actor": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "enum": [
            "operator",
            "registrar"
          ]
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "subject",
        "role",
        "issuer"
      ],
      "additionalProperties": false
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "operation_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "operation_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_hash": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "publication_authorized": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "version",
    "action",
    "status",
    "case_id",
    "case_revision",
    "case_hash",
    "identity",
    "canonical_id",
    "review",
    "requester",
    "actor",
    "at",
    "reason",
    "operation_key",
    "operation_hash",
    "previous_hash",
    "publication_authorized"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aio-code:private:canonical-registry-event:v1",
  "title": "Private immutable canonical registration event v1"
}
