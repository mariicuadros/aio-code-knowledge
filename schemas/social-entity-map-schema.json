  "required": ["map", "version", "entities", "platforms"],
  "properties": {
    "map": {"type": "string"},
    "version": {"type": "string"},
    "updated": {"type": "string", "format": "date"},
    "entities": {"type": "array"},
    "platforms": {"type": "array"}
  },
  "additionalProperties": true
}
