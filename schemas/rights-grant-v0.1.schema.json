{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aio-code.vercel.app/schemas/rights-grant-v0.1.schema.json",
  "title": "AIO CODE rights-grant-v0.1 v0.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordId",
    "responsibleEntityId",
    "createdAt",
    "revision",
    "visibility",
    "reviewStatus",
    "evidenceRefs",
    "kind",
    "workId",
    "grantorEntityId",
    "granteeEntityId",
    "permissions",
    "validFrom",
    "expiresAt",
    "revokedAt",
    "approvalEvidenceIds",
    "humanApprovalRequired"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "recordId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*[0-9]$"
    },
    "responsibleEntityId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*[0-9]$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "visibility": {
      "enum": [
        "private",
        "approved_public"
      ]
    },
    "reviewStatus": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "withdrawn"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kind": {
      "const": "RightsGrant"
    },
    "workId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*[0-9]$"
    },
    "grantorEntityId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*[0-9]$"
    },
    "granteeEntityId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*[0-9]$"
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "view_metadata",
          "publish",
          "reproduce",
          "modify",
          "distribute",
          "train",
          "license"
        ]
      }
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "revokedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approvalEvidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "humanApprovalRequired": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
