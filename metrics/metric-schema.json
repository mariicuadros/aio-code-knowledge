{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIO CODE Metric Measurement",
  "description": "Schema for structured measurements used to quantify changes in digital entity recognition, resolution, representation, retrieval, citation, and recommendation behavior.",
  "type": "object",
  "required": [
    "measurement_id",
    "date",
    "entity_id",
    "metric_id",
    "metric_name",
    "value",
    "unit",
    "status"
  ],
  "properties": {
    "measurement_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "entity_id": {
      "type": "string"
    },
    "experiment_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "observation_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "system": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "query": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "metric_id": {
      "type": "string"
    },
    "metric_name": {
      "type": "string"
    },
    "metric_domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "type": "string"
    },
    "baseline_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "change_absolute": {
      "type": [
        "number",
        "null"
      ]
    },
    "change_relative": {
      "type": [
        "number",
        "null"
      ]
    },
    "raw_observation": {
      "type": [
        "string",
        "null"
      ]
    },
    "interpretation": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Observed",
        "Corroborated",
        "Hypothesized",
        "Verified",
        "Unknown",
        null
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "baseline",
        "measurement",
        "comparison",
        "archived"
      ]
    }
  },
  "additionalProperties": false
}
